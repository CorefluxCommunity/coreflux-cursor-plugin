{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/hooks/session-context.mjs"
      },
      {
        "command": "node ./scripts/hooks/ensure-lot-extension.mjs"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./scripts/hooks/guard-broker-tools.mjs",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./scripts/hooks/guard-shell-commands.mjs",
        "matcher": "mosquitto_pub|Coreflux/Command"
      }
    ]
  }
}
